{
  "name": "boss-helper",
  "displayName": "BossHelper",
  "version": "0.5.2.2",
  "private": true,
  "description": "Boss直聘助手, 皆在减少投递简历的麻烦, 和提高投递简历的效率,技术栈使用VIte + Vue3 + element-plus",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox --mv3",
    "postinstall": "wxt prepare",
    "check": "run-s check:logger-types check:app",
    "build": "run-p build:chrome build:firefox build:edge",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:edge": "wxt build -b edge",
    "zip": "run-p zip:chrome zip:firefox zip:edge",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:edge": "wxt zip -b edge",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "prepare": "husky",
    "test": "bun test ./tests",
    "check:logger-types": "tsc -p packages/devlog-ui/tsconfig.json --declaration --emitDeclarationOnly --noEmit false --declarationMap false --outDir packages/devlog-ui/dist",
    "check:app": "vue-tsc --noEmit",
    "test:browser": "node scripts/smoke-extension.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "@nuxt/ui": "^4.10.0",
    "@vueuse/integrations": "^14.4.0",
    "ai": "^7.0.58",
    "codejar": "^4.3.0",
    "comctx": "^1.7.5",
    "devlog-ui": "workspace:*",
    "idb": "^8.0.3",
    "mqtt": "^5.15.2",
    "partial-json": "^0.1.7",
    "serialize-error": "^13.0.1",
    "spark-md5": "^3.0.2",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "proto2api": "^0.0.8",
    "protobufjs": "^8.7.2",
    "sass": "^1.99.0",
    "ts-proto": "^2.12.0",
    "typescript": "5.9.3",
    "uid": "^2.0.2",
    "vite-plugin-tailwind-shadowdom": "^1.1.1",
    "vue-tsc": "^3.3.9",
    "wxt": "^0.21.3"
  },
  "overrides": {
    "vite": "^8.0.16"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs,vue}": "oxlint --fix"
  }
}
